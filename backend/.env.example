# Backend server-only variables (copy to .env.local; never commit real values - TDD Section 9).

# Port the API listens on (worker ignores it).
PORT=4000
# Allowed browser origin for CORS.
WEB_ORIGIN=http://localhost:3000
# PostgreSQL connection string (Compose `db` uses host `db`; host inner-loop uses localhost).
DATABASE_URL=postgres://leaguelens:leaguelens-local-only@localhost:5432/leaguelens
# Redis connection, only if the redis Compose profile is enabled (TDD Section 4.4).
REDIS_URL=redis://localhost:6379
# CSV upload storage directory (mounted volume locally; object storage when cloud-hosted).
UPLOAD_DIR=./data/uploads
# Sleeper limiter operating target, calls/minute (TDD Section 4.1). Sleeper needs no API key.
SLEEPER_RATE_LIMIT_PER_MIN=700
# Firebase Admin credentials for ID-token verification (M1; emulator needs none locally).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
