# Root variables for Docker Compose (copy to .env; local-only placeholder values below).
# App-level variables live in frontend/.env.example and backend/.env.example (TDD Section 9).

# PostgreSQL (Compose `db` service). Local dev only; use a secret store when deployed.
POSTGRES_DB=leaguelens
POSTGRES_USER=leaguelens
POSTGRES_PASSWORD=leaguelens-local-only

# GraphQL endpoint as seen by the browser (baked into the web build; non-secret).
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
