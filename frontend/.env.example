# Frontend variables (copy to .env.local). NEXT_PUBLIC_* values are published
# to the browser; keep them non-secret (TDD Section 9.2).

# GraphQL endpoint called by the browser.
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# Firebase web config (non-secret; auth lands in M1, emulator needs none locally).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
